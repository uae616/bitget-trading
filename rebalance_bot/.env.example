# Bitget API credentials
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_API_PASSPHRASE=your_passphrase_here

# Set to "true" to use Bitget sandbox / simulated trading
BITGET_USE_SANDBOX=false

# Rebalance trigger: drift threshold (5 % = 0.05)
REBALANCE_THRESHOLD=0.05

# Quote currency used for valuation (must match USDT denominated pairs)
QUOTE_CURRENCY=USDT

# Minimum trade value in quote currency to avoid dust orders
MIN_ORDER_SIZE_QUOTE=10.0

# How often to check (in minutes)
CHECK_INTERVAL_MINUTES=60

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO